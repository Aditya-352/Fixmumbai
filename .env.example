
# 1. App Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=
DOCKER_NETWORK=

# 2. Database Connection
DATABASE_URL=db_url

# 3. Authentication & Security (Google OAuth & JWT)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=GOCS

JWT_SECRET=replace-with-a-long-random-secret

# 4. Geocoding & OpenStreetMap User-Agent
OPENSTREETMAP_USER_AGENT=your-api-key 
# ye vegetation layer show karega 

AGROMONITORING_API_KEY=your-api-key 

# 5. Air Quality layer (Mumbai) — server-side only, never exposed to the client.
# CPCB / data.gov.in: register at https://data.gov.in (My Account > API Key).
# The public sample key works for testing but is capped at ~10 records/call.
CPCB_API_KEY=your-data-gov-in-api-key
# OpenAQ v3: register a free key at https://explore.openaq.org
OPENAQ_API_KEY=your-api-key 

AQICN_API_TOKEN=your-api-key
OPENWEATHER_API_KEY=your-api-key
