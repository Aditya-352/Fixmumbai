# FixMumbai Production Configuration Template

# 1. App Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://fixmumbai.org

# 2. Database Connection
# Local Development: SQLite
DATABASE_URL="file:./dev.db"

# Production Deployment (Supabase / Neon / PostgreSQL / AWS RDS):
# DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# 3. Geocoding & OpenStreetMap User-Agent
OPENSTREETMAP_USER_AGENT="FixMumbai-CivicApp/1.0 (contact@fixmumbai.org)"
