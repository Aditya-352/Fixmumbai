DOCKER_NETWORK=docker network name

# Google OAuth
NEXT_PUBLIC_APP_URL=https://how-network.healthrytix.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Air Quality layer (Mumbai) — server-side only, never exposed to the client.
# CPCB / data.gov.in: register at https://data.gov.in (My Account > API Key).
# The public sample key works for testing but is capped at ~10 records/call.
CPCB_API_KEY=your-data-gov-in-api-key
# OpenAQ v3: register a free key at https://explore.openaq.org
OPENAQ_API_KEY=your-openaq-v3-api-key