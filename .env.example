# FixMumbai Production Configuration Template

# 1. App Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://fixmumbai.org
DOCKER_NETWORK=docker network name

# 2. Database Connection
# Local Development: SQLite
DATABASE_URL="file:./dev.db"

# Production Deployment (Supabase / Neon / PostgreSQL / AWS RDS):
# DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# 3. Authentication & Security (Google OAuth & JWT)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
JWT_SECRET=replace-with-a-long-random-secret

# 4. Geocoding & OpenStreetMap User-Agent
OPENSTREETMAP_USER_AGENT="FixMumbai-CivicApp/1.0 (contact@fixmumbai.org)"

# 5. Air Quality layer (Mumbai) — server-side only, never exposed to the client.
# AQICN / WAQI: register an instant free token at https://aqicn.org/data-platform/token/
AQICN_API_TOKEN=your-aqicn-api-token
# CPCB / data.gov.in: register at https://data.gov.in (My Account > API Key).
# The public sample key works for testing but is capped at ~10 records/call.
CPCB_API_KEY=your-data-gov-in-api-key
# OpenAQ v3: register a free key at https://explore.openaq.org
OPENAQ_API_KEY=your-openaq-v3-api-key
